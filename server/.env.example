NODE_ENV=development
PORT=8011
APP_NAME=HMS API
HOSPITAL_NAME=Metro General Hospital
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

BETTER_AUTH_SECRET=replace-with-a-random-32-plus-char-secret
BETTER_AUTH_URL=http://localhost:8011
FRONTEND_ORIGIN=http://localhost:5173

CLINIC_TIMEZONE=Africa/Lagos
DEFAULT_CURRENCY=NGN

# Required in production
FIELD_ENCRYPTION_KEY=

EMAIL_PROVIDER=stub
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HMS <no-reply@example.test>

DAILY_CODE_LENGTH=14
DAILY_CODE_TTL_MINUTES=1440
DAILY_CODE_MAX_ATTEMPTS=5
DAILY_CODE_SEND_HOUR=6
DAILY_CODE_RESEND_MAX=3
AUTH_SCHEDULER_ENABLED=true
AUTH_SCHEDULER_INTERVAL_MS=60000
AUTH_JOB_LOCK_SECONDS=120
INVITATION_TTL_HOURS=72

TOTP_ISSUER=
TOTP_WINDOW=1
TOTP_MAX_ATTEMPTS=5
TOTP_LOCK_MINUTES=15
TOTP_RECOVERY_CODE_COUNT=10

# Required in production
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hms
CLOUDINARY_URL_EXPIRES_SECONDS=300

PAYMENT_PROVIDER=stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

LOG_LEVEL=info
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20