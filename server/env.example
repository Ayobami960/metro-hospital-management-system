
PORT=8001
NODE_ENV=development
DATABASE_URL=


FRONTEND_ORIGIN=http://localhost:5175




# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
OWNER_EMAIL=
EMAIL_PROVIDER=stub          # stub | smtp | resend
RESEND_API_KEY=

# Authentication
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:8011
FIELD_ENCRYPTION_KEY=        # base64, 32 bytes (required in production)
CLINIC_TIMEZONE=America/New_York

# Purpose-scoped one-time codes
OTP_TTL_MINUTES=15                    # Daily Room Access code
EMAIL_VERIFICATION_TTL_MINUTES=60
PATIENT_LOGIN_TTL_MINUTES=10
ROOM_ACCESS_SESSION_TTL_MINUTES=10    # Room Access authorization window
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
INVITATION_TTL_HOURS=24

# Legacy settings accepted for existing deployments; no scheduler runs.
# DAILY_CODE_* / AUTH_SCHEDULER_* no longer affect sign-in.

# Optional TOTP second factor
TOTP_ISSUER=                 # defaults to HOSPITAL_NAME
TOTP_WINDOW=1
TOTP_MAX_ATTEMPTS=5
TOTP_LOCK_MINUTES=15
TOTP_RECOVERY_CODE_COUNT=10

COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
TRUST_PROXY=1


CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

STORAGE_INTEGRITY_CHECK=true

# Admin seed account
ADMIN_EMAIL=adetoyedaniel2020@gmail.com
