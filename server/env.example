
PORT=8001
NODE_ENV=development
DATABASE_URL=


FRONTEND_ORIGIN=http://localhost:5175




# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
OWNER_EMAIL=
EMAIL_PROVIDER=stub          # stub | smtp | resend
RESEND_API_KEY=

# Authentication
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:8011
FIELD_ENCRYPTION_KEY=        # base64, 32 bytes (required in production)
CLINIC_TIMEZONE=America/New_York

# Daily email sign-in code + backend scheduler
DAILY_CODE_LENGTH=14         # 12-16 alphanumeric characters
DAILY_CODE_TTL_MINUTES=1440
DAILY_CODE_MAX_ATTEMPTS=5
DAILY_CODE_SEND_HOUR=6       # hospital local hour (0-23)
DAILY_CODE_RESEND_MAX=3
AUTH_SCHEDULER_ENABLED=true
AUTH_SCHEDULER_INTERVAL_MS=60000
AUTH_JOB_LOCK_SECONDS=120
INVITATION_TTL_HOURS=72

# Optional TOTP second factor
TOTP_ISSUER=                 # defaults to HOSPITAL_NAME
TOTP_WINDOW=1
TOTP_MAX_ATTEMPTS=5
TOTP_LOCK_MINUTES=15
TOTP_RECOVERY_CODE_COUNT=10

COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
TRUST_PROXY=1


CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

STORAGE_INTEGRITY_CHECK=true

# Admin seed account
ADMIN_EMAIL=adetoyedaniel2020@gmail.com
